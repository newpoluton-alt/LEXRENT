    "bundle": {
      "rules": [
        {
          "team_rule_id": "r-b82190ccabd66396",
          "jurisdiction": "CA",
          "level": "state",
          "category": "just_cause_eviction",
          "status": "in_force",
          "title": "Just cause required to terminate tenancy after 12 months of occupancy",
          "requirement": "After a tenant has continuously and lawfully occupied residential real property for 12 months, the owner may not terminate the tenancy without just cause, and the just cause must be stated in the written termination notice. If additional adult tenants were added before an existing tenant reached 24 months, the rule applies only if all tenants have occupied for 12 months or more, or one or more tenants have occupied for 24 months or more. Just cause is either at-fault or no-fault as defined in subdivision (b).",
          "citation": "Cal. Civ. Code § 1946.2(a)",
          "source_url": "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=CIV&sectionNum=1946.2",
          "quoted_span": "after a tenant has continuously and lawfully occupied a residential real property for 12 months, the owner of the residential real property shall not terminate a tenancy without just cause, which shall be stated in the written notice to terminate tenancy.",
          "key_value": "12 months continuous lawful occupancy",
          "coverage_conditions": {
            "all": [
              {
                "field": "state",
                "op": "eq",
                "value": "CA"
              },
              {
