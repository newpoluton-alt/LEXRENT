# Runtime database credential: the Neon PostgreSQL connection string, not a management API key.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/lexrent?sslmode=require
# Neon Auth branch endpoint.
NEON_AUTH_BASE_URL=https://YOUR-ENDPOINT.neonauth.REGION.neon.tech/lexrent/auth
# Generate a random server-only secret of at least 32 characters.
NEON_AUTH_COOKIE_SECRET=
# Comma-separated verified emails that may import rules, capture sources and run extraction.
LEXRENT_ADMIN_EMAILS=
# Add this key to enable real Claude extraction and answers. Keep server-side; never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# App origin for project configuration; server write checks use the actual request origin.
APP_URL=http://localhost:3000
# Optional management key for future provisioning tools; runtime does not require it.
NEON_API_KEY=
